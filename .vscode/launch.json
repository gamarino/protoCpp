{
  // Debug the target selected in CMake Tools (status bar → launch target).
  // Configure with the RelWithDebInfo build type: an installed protoCore is a
  // Release build, and on Windows a Debug (/MDd) build would mix C runtimes.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "protoCpp: selected target (Windows, MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "protoCpp: selected target (Linux gdb / macOS lldb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "osx": { "MIMode": "lldb" },
      "externalConsole": false
    }
  ]
}
